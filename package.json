{
  "name": "@moejay/pi-secure",
  "version": "0.1.2",
  "type": "module",
  "description": "Private secret entry, capture, local reveal/copy, and redacted shell execution for Pi. Transcript hygiene, not a sandbox.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "secrets",
    "security",
    "privacy",
    "credentials",
    "clipboard",
    "developer-tools"
  ],
  "license": "MIT",
  "author": "moejay",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moejay/pi-secure.git"
  },
  "homepage": "https://moejay.github.io/pi-secure/",
  "bugs": {
    "url": "https://github.com/moejay/pi-secure/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "index.ts",
    "secure.mjs",
    "clipboard.mjs",
    "README.md",
    "SECURITY.md",
    "RELEASING.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "image": "https://moejay.github.io/pi-secure/media/preview.png",
    "video": "https://moejay.github.io/pi-secure/media/demo.mp4"
  },
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  }
}
